# Copy to .env.production and chmod 600. Read with Compose --env-file, not source.
COMPOSE_PROJECT_NAME=corn-production
RELEASE_VERSION=phase2-local
POSTGRES_DB=corn_research
POSTGRES_USER=corn_user
# Generate each password separately: openssl rand -hex 32
# Hex avoids URL escaping and Compose interpolation surprises. Never commit secrets.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BACKEND_PORT=18000
FRONTEND_PORT=3080
# Build-time browser URL; requires frontend rebuild after a change.
NEXT_PUBLIC_API_URL=/backend
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
RUST_LOG=info,sqlx=warn,sea_orm=warn
RUST_BACKTRACE=0
COLLECTOR_LOG_LEVEL=INFO
COLLECTOR_LOG_MAX_BYTES=10485760
COLLECTOR_LOG_BACKUP_COUNT=5
BOYAR_START_ARTICLE_ID=1267743
BOYAR_SCAN_LIMIT=150
SINA_FUTURES_SYMBOLS=nf_C0
DCE_CONTRACTS=
DCE_START_DATE=
DCE_MAX_DAYS=31
# Optional docker-compose.monitoring.yml: endpoints bind only to loopback.
PROMETHEUS_PORT=19090
