# 生产环境配置示例
# 复制此文件为 .env.production 并填入实际值

# 数据库配置
POSTGRES_DB=corn_research
POSTGRES_USER=corn_user
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_PORT=15432

# Redis配置
REDIS_PORT=16380

# 后端配置
BACKEND_PORT=18000
RUST_LOG=info
RUST_BACKTRACE=0

# 前端配置
FRONTEND_PORT=3080
NEXT_PUBLIC_API_URL=http://your-domain.com:18000

# 或使用内部地址（如果通过Nginx代理）
# NEXT_PUBLIC_API_URL=http://backend:18000

# 安全配置
# JWT_SECRET=your-jwt-secret-here
# API_KEY=your-api-key-here

# 通知配置（未来使用）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@corn-research.com
# SMTP_PASSWORD=your-smtp-password

# 监控配置（未来使用）
# SENTRY_DSN=your-sentry-dsn
# PROMETHEUS_PORT=9090
